# Local XAMPP / MySQL settings. Copy this file to .env and adjust as needed.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=aviator

# Optional: use this instead of the MYSQL_* values above.
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/aviator?charset=utf8mb4

ADMIN_PHONE=+254700000000
